const API_URL = 'http://localhost:8081/api';

const router = {
    routes: {},
    add: function (path, callback) {
        this.routes[path] = callback;
    },
    navigate: function (path) {
        window.location.hash = path;
        this.handle();
    },
    handle: function () {
        const path = window.location.hash.slice(1) || 'login';
        if (this.routes[path]) {
            this.routes[path]();
        } else {
            console.log('Route not found:', path);
            this.navigate('login');
        }
    }
};

const store = {
    token: localStorage.getItem('token'),
    user: JSON.parse(localStorage.getItem('user')),

    setAuth: function (token, user) {
        this.token = token;
        this.user = user;
        localStorage.setItem('token', token);
        localStorage.setItem('user', JSON.stringify(user));
        updateNav();
    },

    logout: function () {
        this.token = null;
        this.user = null;
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        updateNav();
        router.navigate('login');
    }
};

// API Helper
async function api(endpoint, method = 'GET', body = null, isFormData = false) {
    const headers = {};
    if (store.token) {
        headers['Authorization'] = 'Bearer ' + store.token;
    }
    if (!isFormData) {
        headers['Content-Type'] = 'application/json';
    }

    const config = {
        method,
        headers,
    };

    if (body) {
        config.body = isFormData ? body : JSON.stringify(body);
    }

    // Remove Content-Type header for FormData (browser sets it with boundary)
    if (isFormData) {
        delete headers['Content-Type'];
    }

    const response = await fetch(API_URL + endpoint, config);
    if (response.status === 401) {
        store.logout();
        return Promise.reject('Unauthorized');
    }

    if (!response.ok) {
        const err = await response.text();
        throw new Error(err || response.statusText);
    }

    // Attempt parse JSON, else text
    try {
        return await response.json();
    } catch (e) {
        return null;
    }
}

// Views
function renderLogin() {
    const template = document.getElementById('login-template').content.cloneNode(true);
    const app = document.getElementById('app');
    app.innerHTML = '';
    app.appendChild(template);

    document.getElementById('login-form').onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);

        try {
            const res = await api('/auth/login', 'POST', data);
            store.setAuth(res.token, {
                id: res.id,
                username: res.username,
                roles: res.roles
            });
            router.navigate('dashboard');
        } catch (err) {
            alert('Login failed: ' + err.message);
        }
    };
}

function renderRegister() {
    const template = document.getElementById('register-template').content.cloneNode(true);
    const app = document.getElementById('app');
    app.innerHTML = '';
    app.appendChild(template);

    document.getElementById('register-form').onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);
        // data.role expects array/set but simplistic form returns string
        // The API might expect ["citizen"]
        data.role = [data.role];

        try {
            await api('/auth/register', 'POST', data);
            alert('Registration successful! Please login.');
            router.navigate('login');
        } catch (err) {
            alert('Registration failed: ' + err.message);
        }
    };
}

async function renderDashboard() {
    if (!store.user) return router.navigate('login');

    const isCitizen = store.user.roles.includes('ROLE_CITIZEN');
    const isStaff = store.user.roles.includes('ROLE_STAFF');
    const isAdmin = store.user.roles.includes('ROLE_ADMIN');

    // Fetch Staff if Admin
    let staffList = [];
    if (isAdmin) {
        try {
            staffList = await api('/admin/staff');
        } catch (e) { console.error("Failed to load staff", e); }
    }

    const heading = isCitizen ? 'My Reported Issues' : 'Issue Queue (All)';
    const reportBtn = isCitizen ? `<button class="btn btn-primary" onclick="router.navigate('report')">Report New Issue</button>` : '';
    const adminBtn = isAdmin ? `<button class="btn btn-warning" onclick="router.navigate('admin')">Admin Stats</button>` : '';

    const app = document.getElementById('app');
    app.innerHTML = `
        <div class="card">
            <h2>Dashboard</h2>
            <div style="margin-bottom: 1rem;">
                ${reportBtn}
                ${adminBtn}
                <button class="btn btn-success" onclick="router.navigate('map')">View Map</button>
            </div>
            
            <h3>${heading}</h3>
            <div id="issues-list" class="dashboard-grid">Loading...</div>
        </div>
    `;

    // Fetch logic differs by role. Citizen: my issues. Staff/Admin: all issues
    const endpoint = isCitizen ? '/issues/my' : '/issues';

    try {
        const issues = await api(endpoint);
        const list = document.getElementById('issues-list');
        if (!issues || issues.length === 0) {
            list.innerHTML = '<p>No issues found.</p>';
            return;
        }

        list.innerHTML = issues.map(issue => {
            // Assign UI
            let assignUI = '';
            if (isAdmin && (issue.status === 'NEW' || issue.status === 'ASSIGNED')) {
                const options = staffList.map(s => `<option value="${s.id}" ${issue.assignedTo && issue.assignedTo.id === s.id ? 'selected' : ''}>${s.fullName}</option>`).join('');
                assignUI = `
                    <div style="margin-top:0.5rem; padding-top:0.5rem; border-top:1px solid #eee;">
                        <label>Assign to:</label>
                        <select id="staff-select-${issue.id}" style="padding:4px;">
                            <option value="">Select Staff</option>
                            ${options}
                        </select>
                        <button class="btn btn-sm" onclick="assignIssue(${issue.id})">Assign</button>
                    </div>
                `;
            } else if (issue.assignedTo) {
                assignUI = `<div style="margin-top:0.5rem"><small>Assigned to: <b>${issue.assignedTo.fullName}</b></small></div>`;
            }

            // Location display
            const locationInfo = issue.latitude && issue.longitude
                ? `<div style="margin-top:0.5rem; font-size:0.85rem; color:#64748b;">
                     📍 ${issue.latitude.toFixed(4)}, ${issue.longitude.toFixed(4)}
                   </div>`
                : '';

            return `
            <div class="issue-card">
                ${issue.imagePath ? `<img src="${issue.imagePath}" alt="Issue Image">` : ''}
                <h4>${issue.title}</h4>
                <p>${issue.description}</p>
                <div style="margin-top: 0.5rem">
                    <span class="status-badge status-${issue.status}">${issue.status}</span>
                    <span class="status-badge" style="background:#ddd; color:#333">${issue.priority}</span>
                    <span class="status-badge" style="background:#ddd; color:#333">${issue.category || 'N/A'}</span>
                </div>
                ${locationInfo}
                ${assignUI}
                <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    ${issue.latitude && issue.longitude ? `
                        <button class="btn btn-sm btn-success" onclick="viewIssueOnMap(${issue.id}, ${issue.latitude}, ${issue.longitude})" style="flex: 1;">
                            🗺️ View on Map
                        </button>
        app.innerHTML = '<h2>Admin Dashboard</h2><div id="stats" class="dashboard-grid">Loading...</div>';

        try {
            const stats = await api('/admin/dashboard');
            const container = document.getElementById('stats');
            container.innerHTML = `
                    < div class="card" ><h3>Total Users</h3><p>${stats.totalUsers}</p></div >
                        <div class="card"><h3>Total Issues</h3><p>${stats.totalIssues}</p></div>
            `;
        } catch (err) {
            console.error(err);
        }
    }

    function renderReport() {
        if (!store.user) return router.navigate('login');

        const app = document.getElementById('app');
        app.innerHTML = `
                < div class="card" >
            <h2>Report Issue</h2>
            <form id="report-form">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" name="title" required>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" required rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select name="category">
                        <option value="Pothole">Pothole</option>
                        <option value="Streetlight Failure">Streetlight Failure</option>
                        <option value="Garbage Dump">Garbage Dump</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
               <div class="form-group">
                    <label>Priority</label>
                    <select name="priority">
                        <option value="LOW">Low</option>
                        <option value="MEDIUM">Medium</option>
                        <option value="HIGH">High</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Location</label>
                    <div style="margin-bottom: 0.5rem; display: flex; gap: 0.5rem;">
                        <button type="button" id="btn-track-live" class="btn btn-success" style="flex: 1;">
                            📍 Track Live Location
                        </button>
                        <button type="button" id="btn-stop-track" class="btn btn-danger" style="flex: 1; display: none;">
                            ⏹️ Stop Tracking
                        </button>
                        <button type="button" id="btn-use-current" class="btn btn-primary" style="flex: 1;">
                            📌 Use Current Location
                        </button>
                    </div>
                    <div id="report-map" class="map-container" style="height: 400px;"></div>
                    <input type="hidden" name="latitude" id="lat" required>
                    <input type="hidden" name="longitude" id="lng" required>
                    <p id="loc-status" style="margin-top: 0.5rem; padding: 0.5rem; background: #f0f9ff; border-radius: 6px; font-size: 0.9rem;">
                        <strong>📍 Location:</strong> Click map to set location manually or use GPS buttons above
                    </p>
                    <p id="accuracy-status" style="margin-top: 0.5rem; font-size: 0.85rem; color: #64748b;"></p>
                </div>
                <div class="form-group">
                    <label>Image</label>
                    <input type="file" name="image" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Report</button>
            </form>
        </div>
    `;

        // Map Setup
        const map = L.map('report-map').setView([51.505, -0.09], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        let marker;
        let liveMarker;
        let accuracyCircle;
        let trackingInterval;
        let isTracking = false;

        // Custom icon for live location
        const liveLocationIcon = L.divIcon({
            className: 'live-location-marker',
            html: `<div style="position: relative;">
                <div style="width: 20px; height: 20px; background: #3b82f6; border: 3px solid white; border-radius: 50%; box-shadow: 0 0 10px rgba(59, 130, 246, 0.5); animation: pulse 2s infinite;"></div>
                <div style="position: absolute; top: -5px; left: -5px; width: 30px; height: 30px; background: rgba(59, 130, 246, 0.2); border-radius: 50%; animation: ripple 2s infinite;"></div>
               </div>`,
            iconSize: [20, 20],
            iconAnchor: [10, 10]
        });

        // Add CSS animations for live marker
        if (!document.getElementById('live-marker-styles')) {
            const style = document.createElement('style');
            style.id = 'live-marker-styles';
            style.textContent = `
            @keyframes pulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.1); }
            }
            @keyframes ripple {
                0% { transform: scale(0.8); opacity: 1; }
                100% { transform: scale(2); opacity: 0; }
            }
        `;
            document.head.appendChild(style);
        }

        // Manual map click
        map.on('click', function (e) {
            setLocation(e.latlng.lat, e.latlng.lng, false);
        });

        // Function to update location
        function setLocation(lat, lng, isLive = false, accuracy = null) {
            document.getElementById('lat').value = lat;
            document.getElementById('lng').value = lng;

            // Remove old marker if not live tracking
            if (!isLive && marker) {
                map.removeLayer(marker);
            }

            // Add/update marker
            if (isLive) {
                if (liveMarker) {
                    liveMarker.setLatLng([lat, lng]);
                } else {
                    liveMarker = L.marker([lat, lng], { icon: liveLocationIcon }).addTo(map);
                    liveMarker.bindPopup('<b>Your Live Location</b><br>Tracking in real-time').openPopup();
                }

                // Update accuracy circle
                if (accuracyCircle) {
                    map.removeLayer(accuracyCircle);
                }
                if (accuracy) {
                    accuracyCircle = L.circle([lat, lng], {
                        radius: accuracy,
                        color: '#3b82f6',
                        fillColor: '#3b82f6',
                        fillOpacity: 0.1,
                        weight: 1
                    }).addTo(map);
                }
            } else {
                marker = L.marker([lat, lng]).addTo(map);
                marker.bindPopup('<b>Issue Location</b><br>Click to reposition').openPopup();
            }

            // Update status
            const statusEl = document.getElementById('loc-status');
            const accuracyEl = document.getElementById('accuracy-status');

            if (isLive) {
                statusEl.innerHTML = `<strong>🟢 Live Tracking:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                statusEl.style.background = '#d1fae5';
                statusEl.style.color = '#065f46';

                if (accuracy) {
                    accuracyEl.innerHTML = `📊 Accuracy: ±${Math.round(accuracy)} meters`;
                    accuracyEl.style.color = accuracy < 50 ? '#059669' : accuracy < 100 ? '#f59e0b' : '#ef4444';
                }
            } else {
                statusEl.innerHTML = `<strong>📍 Location Set:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                statusEl.style.background = '#f0f9ff';
                statusEl.style.color = '#0c4a6e';
                accuracyEl.innerHTML = '';
            }
        }

        // Start live tracking
        function startLiveTracking() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser');
                return;
            }

            isTracking = true;
            document.getElementById('btn-track-live').style.display = 'none';
            document.getElementById('btn-stop-track').style.display = 'block';
            document.getElementById('btn-use-current').disabled = true;

            // Watch position with high accuracy
            trackingInterval = navigator.geolocation.watchPosition(
                (position) => {
                    const { latitude, longitude, accuracy } = position.coords;
                    setLocation(latitude, longitude, true, accuracy);
                    map.setView([latitude, longitude], 16);
                },
                (error) => {
                    console.error('Geolocation error:', error);
                    stopLiveTracking();
                    alert('Unable to track location: ' + error.message);
                },
                {
                    enableHighAccuracy: true,
                    timeout: 5000,
                    maximumAge: 0
                }
            );
        }

        // Stop live tracking
        function stopLiveTracking() {
            if (trackingInterval) {
                navigator.geolocation.clearWatch(trackingInterval);
                trackingInterval = null;
            }

            isTracking = false;
            document.getElementById('btn-track-live').style.display = 'block';
            document.getElementById('btn-stop-track').style.display = 'none';
            document.getElementById('btn-use-current').disabled = false;

            // Convert live marker to regular marker
            if (liveMarker) {
                const pos = liveMarker.getLatLng();
                map.removeLayer(liveMarker);
                liveMarker = null;

                if (accuracyCircle) {
                    map.removeLayer(accuracyCircle);
                    accuracyCircle = null;
                }

                setLocation(pos.lat, pos.lng, false);
            }

            const statusEl = document.getElementById('loc-status');
            statusEl.innerHTML = statusEl.innerHTML.replace('🟢 Live Tracking', '📍 Location Set');
            statusEl.style.background = '#f0f9ff';
            statusEl.style.color = '#0c4a6e';
        }

        // Use current location once
        function useCurrentLocation() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser');
                return;
            }

            document.getElementById('loc-status').innerHTML = '<strong>🔄 Getting your location...</strong>';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const { latitude, longitude } = position.coords;
                    setLocation(latitude, longitude, false);
                    map.setView([latitude, longitude], 16);
                },
                (error) => {
                    console.error('Geolocation error:', error);
                    alert('Unable to get location: ' + error.message);
                    document.getElementById('loc-status').innerHTML = '<strong>❌ Location failed.</strong> Please click on map.';
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }

        // Event listeners
        document.getElementById('btn-track-live').onclick = startLiveTracking;
        document.getElementById('btn-stop-track').onclick = stopLiveTracking;
        document.getElementById('btn-use-current').onclick = useCurrentLocation;

        // Form submission
        document.getElementById('report-form').onsubmit = async (e) => {
            e.preventDefault();

            // Stop tracking if active
            if (isTracking) {
                stopLiveTracking();
            }

            const formData = new FormData(e.target);

            try {
                await api('/issues', 'POST', formData, true);
                alert('Issue reported successfully!');
                router.navigate('dashboard');
            } catch (err) {
                alert('Failed to report: ' + err.message);
            }
        };

        // Cleanup on navigation
        window.addEventListener('hashchange', () => {
            if (trackingInterval) {
                navigator.geolocation.clearWatch(trackingInterval);
            }
        }, { once: true });

        // Invalidate size after render
        setTimeout(() => map.invalidateSize(), 100);
    }

    async function renderMap() {
        const app = document.getElementById('app');
        app.innerHTML = `
        <div class="card" style="height: 85vh; padding: 1rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="margin: 0;">Issue Map</h2>
                <div>
                    <button class="btn btn-sm btn-primary" onclick="router.navigate('dashboard')">← Dashboard</button>
                </div>
            </div>
            <div id="full-map" style="height: calc(100% - 60px); width: 100%; border-radius: 12px;"></div>
        </div>
        
        <!-- Issue Details Modal -->
        <div id="issue-modal" class="modal" onclick="closeIssueModal(event)">
            <div class="modal-content" onclick="event.stopPropagation()">
                <div id="modal-body"></div>
                <button class="btn btn-primary" style="margin-top: 1rem; width: 100%;" onclick="closeIssueModal()">Close</button>
            </div>
        </div>
    `;

        const map = L.map('full-map').setView([51.505, -0.09], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Custom marker icons based on status
        const getMarkerColor = (status) => {
            const colors = {
                'NEW': '#667eea',
                'ASSIGNED': '#f59e0b',
                'IN_PROGRESS': '#3b82f6',
                'RESOLVED': '#10b981',
                'CLOSED': '#6b7280'
            };
            return colors[status] || '#667eea';
        };

        const createCustomIcon = (status) => {
            const color = getMarkerColor(status);
            return L.divIcon({
                className: 'custom-marker',
                html: `<div style="background-color: ${color}; width: 30px; height: 30px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); border: 3px solid white; box-shadow: 0 2px 8px rgba(0,0,0,0.3);"><div style="transform: rotate(45deg); margin-top: 3px; margin-left: 3px; font-size: 16px; color: white;">📍</div></div>`,
                iconSize: [30, 30],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
        };

        // Fetch all issues
        try {
            const issues = await api('/issues');
            const markers = [];
            let focusedMarker = null;

            // Check if we need to focus on a specific issue
            const focusIssueData = sessionStorage.getItem('focusIssue');
            let focusIssue = null;
            if (focusIssueData) {
                focusIssue = JSON.parse(focusIssueData);
                sessionStorage.removeItem('focusIssue'); // Clear after reading
            }

            issues.forEach(issue => {
                if (issue.latitude && issue.longitude) {
                    const icon = createCustomIcon(issue.status);
                    const marker = L.marker([issue.latitude, issue.longitude], { icon }).addTo(map);

                    // Check if this is the focused issue
                    const isFocused = focusIssue && issue.id === focusIssue.id;

                    marker.bindPopup(`
                    <div style="min-width: 200px;">
                        <h4 style="margin: 0 0 0.5rem 0; color: #2d3748;">${issue.title}</h4>
                        <p style="margin: 0.25rem 0; font-size: 0.9rem; color: #64748b;">${issue.category || 'N/A'}</p>
                        <div style="margin: 0.5rem 0;">
                            <span class="status-badge status-${issue.status}" style="font-size: 0.7rem;">${issue.status}</span>
                        </div>
                        <button onclick="showIssueDetails(${issue.id})" class="btn btn-sm btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.4rem;">View Details</button>
                    </div>
                `);

                    markers.push(marker);

                    // If this is the focused issue, save the marker and open popup
                    if (isFocused) {
                        focusedMarker = marker;
                    }
                }
            });

            // Handle focused issue
            if (focusedMarker) {
                // Center on the focused issue with higher zoom
                map.setView(focusedMarker.getLatLng(), 16);
                // Open the popup
                setTimeout(() => {
                    focusedMarker.openPopup();
                    // Add a pulsing circle around the focused marker
                    const pulseCircle = L.circle(focusedMarker.getLatLng(), {
                        radius: 50,
                        color: '#667eea',
                        fillColor: '#667eea',
                        fillOpacity: 0.2,
                        weight: 2,
                        className: 'pulse-circle'
                    }).addTo(map);

                    // Remove pulse circle after 3 seconds
                    setTimeout(() => {
                        map.removeLayer(pulseCircle);
                    }, 3000);
                }, 300);
            } else {
                // Fit bounds if issues exist and no focus
                if (markers.length > 0) {
                    const group = new L.featureGroup(markers);
                    map.fitBounds(group.getBounds().pad(0.1));
                }
            }
        } catch (err) {
            console.error(err);
            alert('Failed to load issues on map');
        }

        setTimeout(() => map.invalidateSize(), 100);
    }

    window.showIssueDetails = async function (issueId) {
        try {
            const issues = await api('/issues');
            const issue = issues.find(i => i.id === issueId);

            if (!issue) {
                alert('Issue not found');
                return;
            }

            const modalBody = document.getElementById('modal-body');
            modalBody.innerHTML = `
            <h3 style="margin-top: 0; color: var(--primary-color);">${issue.title}</h3>
            ${issue.imagePath ? `<img src="${issue.imagePath}" style="width: 100%; border-radius: 8px; margin: 1rem 0;">` : ''}
            <p><strong>Category:</strong> ${issue.category || 'N/A'}</p>
            <p><strong>Description:</strong> ${issue.description}</p>
            <p><strong>Priority:</strong> <span class="status-badge" style="background: #ddd; color: #333;">${issue.priority}</span></p>
            <p><strong>Status:</strong> <span class="status-badge status-${issue.status}">${issue.status}</span></p>
            <p><strong>Reported:</strong> ${new Date(issue.reportTime).toLocaleString()}</p>
            ${issue.assignedTo ? `<p><strong>Assigned to:</strong> ${issue.assignedTo.fullName}</p>` : ''}
            ${issue.resolutionTime ? `<p><strong>Resolved:</strong> ${new Date(issue.resolutionTime).toLocaleString()}</p>` : ''}
            <p><strong>Location:</strong> ${issue.latitude.toFixed(4)}, ${issue.longitude.toFixed(4)}</p>
        `;

            document.getElementById('issue-modal').style.display = 'flex';
        } catch (err) {
            console.error(err);
            alert('Failed to load issue details');
        }
    };

    window.closeIssueModal = function (event) {
        if (!event || event.target.id === 'issue-modal') {
            document.getElementById('issue-modal').style.display = 'none';
        }
    };

    // Nav Logic
    function updateNav() {
        const nav = document.getElementById('nav-links');
        if (store.user) {
            nav.innerHTML = `
            <span>Hello, ${store.user.username}</span>
            <a href="#dashboard">Dashboard</a>
            ${store.user.roles.includes('ROLE_ADMIN') ? '<a href="#admin">Admin</a>' : ''}
            <a href="#" onclick="store.logout()">Logout</a>
        `;
        } else {
            nav.innerHTML = `
            <a href="#login">Login</a>
            <a href="#register">Register</a>
        `;
        }
    }

    // Init
    window.addEventListener('hashchange', () => router.handle());
    window.addEventListener('DOMContentLoaded', () => {
        router.add('login', renderLogin);
        router.add('register', renderRegister);
        router.add('dashboard', renderDashboard);
        router.add('report', renderReport);
        router.add('map', renderMap);
        router.add('admin', renderAdmin);

        updateNav();
        router.handle();
    });
